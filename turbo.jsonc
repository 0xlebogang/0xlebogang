{
	"$schema": "./node_modules/turbo/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": [".env", ".env.local"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"test": {},
		"lint": {},
		"lint:fix": {}
	}
}
