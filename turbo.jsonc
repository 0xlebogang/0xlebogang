{
	"$schema": "./node_modules/turbo/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": [".env", ".env.local", "!.env.example"]
		},
		"test": {},
		"lint": {},
		"lint:fix": {},
		"start": {
			"cache": false,
			"persistent": true
		}
	}
}
